{
  "configVersion": 1,
  "description": "File browser with a plain-text editor.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "folder": {
        "type": ["string", "null"],
        "description": "Absolute path, at most 8192 bytes, no NUL. Defaults to session directory on creation; successful navigation remembers the current folder.",
        "absolutePath": true,
        "maxBytes": 8192
      },
      "editorFile": {
        "type": ["string", "null"],
        "description": "Absolute selected file path to reopen, at most 8192 bytes, no NUL. Opening/returning from the editor updates this field. Restores local drafts when available, otherwise saved file contents or unsupported-file details.",
        "absolutePath": true,
        "maxBytes": 8192
      },
      "browserPreferences": {
        "type": ["object", "null"],
        "description": "Optional local browser preferences, overriding application and session defaults. Null or omitted inherits shared settings.",
        "additionalProperties": false,
        "properties": {
          "showHidden": {
            "type": "boolean",
            "description": "Display hidden files."
          },
          "order": {
            "type": "string",
            "enum": [
              "nameAscending",
              "nameDescending",
              "dateAscending",
              "dateDescending",
              "sizeAscending",
              "sizeDescending"
            ],
            "description": "Sort order, folders first."
          }
        }
      }
    }
  },
  "examples": [
    {},
    {
      "folder": null
    }
  ],
  "notes": [
    "Browsing requires an accessible directory. Configuration does not create directories."
  ],
  "id": "files",
  "label": "Files",
  "sdkVersion": 1,
  "defaults": {
    "folder": null,
    "editorFile": null
  },
  "capabilities": ["fs", "desktop", "storage", "tabs"],
  "runtime": null,
  "contextDefaults": {
    "folder": "session.directory"
  },
  "entrypoint": "entrypoint.tsx",
  "interactions": {
    "version": 1,
    "state": {
      "description": "Current folder, selected file and editor status. No file contents.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "folder": {
                "type": ["string", "null"]
              },
              "selectedFile": {
                "type": ["string", "null"]
              },
              "dirty": {
                "type": "boolean"
              },
              "conflict": {
                "type": "boolean"
              },
              "loading": {
                "type": "boolean"
              },
              "error": {
                "type": ["string", "null"]
              }
            },
            "required": ["folder", "selectedFile", "dirty", "conflict", "loading", "error"]
          },
          "observedAt": {
            "type": ["string", "null"]
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": ["summary", "data", "observedAt", "stale"]
      },
      "examples": [
        {
          "args": {},
          "result": {
            "summary": "File /tmp/example.txt",
            "data": {
              "folder": "/tmp",
              "selectedFile": "/tmp/example.txt",
              "dirty": false,
              "conflict": false,
              "loading": false,
              "error": null
            },
            "observedAt": "2026-11-04T12:00:00.000Z",
            "stale": false
          }
        }
      ]
    },
    "actions": {
      "open-path": {
        "description": "Open an existing absolute file path in this tab without selecting the tab or changing the explorer folder. Reuses UI draft-preserving file switching; busy editors or unpreserved edits reject the action. Unsupported text shows file details without launching an external application. Does not create files.",
        "readOnly": false,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "absolutePath": true,
              "maxBytes": 8192,
              "description": "Absolute path to an existing regular file."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "view"],
          "properties": {
            "path": {
              "type": "string"
            },
            "view": {
              "type": "string",
              "enum": ["editor", "details"]
            }
          }
        },
        "examples": [
          {
            "args": {
              "path": "/tmp/example.txt"
            },
            "result": {
              "path": "/tmp/example.txt",
              "view": "editor"
            }
          }
        ]
      }
    }
  }
}
