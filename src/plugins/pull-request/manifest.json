{
  "configVersion": 1,
  "description": "Read-only GitHub PR status, using a plugin-owned GitHub token and the session's explicit PR association.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "refreshIntervalSeconds": {
        "type": ["integer", "null"],
        "description": "Optional local refresh interval, 30 to 86400 seconds. Null or omitted inherits the session and global defaults (120 seconds)."
      },
      "connection": {
        "type": "string",
        "enum": ["inherit", "tab"],
        "description": "Use the session account (default), or a token saved exclusively for this tab."
      },
      "pullRequest": {
        "type": ["object", "null"],
        "description": "Optional local PR association; null or omitted inherits the session association.",
        "additionalProperties": false,
        "required": ["repository", "number"],
        "properties": {
          "repository": {
            "type": "string",
            "description": "Explicit GitHub owner/repository.",
            "maxBytes": 512
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive PR number."
          }
        }
      }
    }
  },
  "examples": [{}],
  "notes": [
    "Repository and PR number default to the session association; pullRequest optionally overrides them for one tab.",
    "Set shared accounts, refresh defaults and the session association through shared plugin settings; local account, association and interval overrides remain in tab configuration.",
    "Omitted or null refreshIntervalSeconds inherits session/global defaults; explicit values from 30 to 86400 seconds remain local."
  ],
  "id": "pull-request",
  "label": "Pull request",
  "sdkVersion": 1,
  "defaults": {},
  "capabilities": ["env", "http", "credentials", "desktop", "storage"],
  "runtime": null,
  "entrypoint": "entrypoint.tsx",
  "interactions": {
    "version": 1,
    "state": {
      "description": "Last PR status, review/check counts and refresh status. No review bodies or network refresh.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "loading": {
                "type": "boolean"
              },
              "url": {
                "type": ["string", "null"]
              },
              "title": {
                "type": ["string", "null"]
              },
              "state": {
                "type": ["string", "null"]
              },
              "draft": {
                "type": ["boolean", "null"]
              },
              "reviewDecision": {
                "type": ["string", "null"]
              },
              "reviewCount": {
                "type": "integer",
                "minimum": 0
              },
              "checkCount": {
                "type": "integer",
                "minimum": 0
              },
              "pipeline": {
                "type": ["string", "null"]
              },
              "lastRefresh": {
                "type": ["string", "null"]
              },
              "refreshError": {
                "type": ["string", "null"]
              },
              "reviewSummary": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "loading",
              "url",
              "title",
              "state",
              "draft",
              "reviewDecision",
              "reviewCount",
              "checkCount",
              "pipeline",
              "lastRefresh",
              "refreshError",
              "reviewSummary"
            ]
          },
          "observedAt": {
            "type": ["string", "null"]
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": ["summary", "data", "observedAt", "stale"]
      },
      "examples": [
        {
          "args": {}
        }
      ]
    },
    "actions": {}
  }
}
