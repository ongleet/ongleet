{
  "configVersion": 1,
  "description": "A contained PTY process. Inherits the normal process environment; stores explicit overrides only.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cwdOverride": {
        "type": ["string", "null"],
        "description": "Absolute working directory. Omitted/null uses the session directory."
      },
      "executable": {
        "type": ["string", "null"],
        "description": "Executable path or PATH name. Omitted/null uses the user shell."
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Literal argument array; no shell expansion."
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "description": "Explicit environment overrides."
      },
      "shellCommand": {
        "type": ["string", "null"],
        "description": "Explicit shell syntax; cannot be combined with executable or nonempty args."
      }
    }
  },
  "examples": [
    {
      "executable": "/bin/bash",
      "args": [],
      "env": {}
    },
    {
      "executable": "/usr/bin/python3",
      "args": ["-c", "print('hello')"],
      "env": {}
    },
    {
      "shellCommand": "printf '%s\n' hello",
      "env": {}
    }
  ],
  "notes": [
    "Commands and arguments cannot contain NUL bytes. Explicit executable and shellCommand must be nonempty.",
    "cwdOverride must be absolute; the launch directory must exist.",
    "Environment keys must be nonempty and contain neither '=' nor NUL; values cannot contain NUL.",
    "Configuration changes affect future launches; running processes retain their launch settings."
  ],
  "id": "terminal",
  "label": "Terminal",
  "sdkVersion": 1,
  "defaults": {
    "cwdOverride": null,
    "executable": null,
    "args": [],
    "env": {},
    "shellCommand": null
  },
  "capabilities": ["pty", "desktop", "storage"],
  "runtime": "pty",
  "entrypoint": "entrypoint.tsx",
  "interactions": {
    "version": 1,
    "state": {
      "description": "Recent physical lines of the active Ghostty buffer, process status and dimensions. Alternate screen is not command history.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["running", "exited"]
                  },
                  "code": {
                    "type": "integer"
                  }
                },
                "required": ["state"]
              },
              "cols": {
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "screen": {
                "type": "string",
                "enum": ["normal", "alternate"]
              },
              "totalLines": {
                "type": "integer",
                "minimum": 0
              },
              "returnedLines": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              },
              "replaying": {
                "type": "boolean"
              }
            },
            "required": [
              "lines",
              "status",
              "cols",
              "rows",
              "screen",
              "totalLines",
              "returnedLines",
              "truncated",
              "replaying"
            ]
          },
          "observedAt": {
            "type": ["string", "null"]
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": ["summary", "data", "observedAt", "stale"]
      },
      "examples": [
        {
          "args": {}
        }
      ]
    },
    "actions": {
      "send-text": {
        "description": "Write literal UTF-8 and optional CR to this terminal. Acknowledges writes, not command completion. 8 KiB including CR.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxBytes": 8192
            },
            "enter": {
              "type": "boolean"
            }
          },
          "required": ["text"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acknowledged": {
              "type": "boolean"
            }
          },
          "required": ["acknowledged"]
        },
        "examples": [
          {
            "args": {
              "text": "hello",
              "enter": false
            },
            "result": {
              "acknowledged": true
            }
          }
        ],
        "readOnly": false
      }
    }
  }
}
