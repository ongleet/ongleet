{
  "id": "diff",
  "label": "Diff",
  "description": "Read-only Git changes with unified patches.",
  "configVersion": 1,
  "sdkVersion": 1,
  "entrypoint": "entrypoint.tsx",
  "runtime": null,
  "capabilities": ["process", "storage"],
  "defaults": {
    "folder": null,
    "mode": "branch",
    "baseRef": "HEAD~1",
    "targetRef": "HEAD",
    "compareFrom": "divergence",
    "includeUncommitted": false
  },
  "contextDefaults": {
    "folder": "session.directory"
  },
  "examples": [
    {},
    {
      "mode": "refs",
      "baseRef": "HEAD~1",
      "targetRef": "HEAD"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "folder": {
        "type": ["string", "null"],
        "absolutePath": true,
        "maxBytes": 8192,
        "description": "Repository directory; defaults to session directory."
      },
      "mode": {
        "type": "string",
        "enum": ["branch", "refs", "auto", "workingDirectory", "mergeBase", "sinceCommit"],
        "description": "branch: detected base or selected commit to HEAD, optionally including local changes; refs: two committed snapshots. Other values are accepted for legacy saved tabs."
      },
      "baseRef": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Starting revision for refs mode."
      },
      "targetRef": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Destination revision for refs mode."
      },
      "compareFrom": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Branch starting commit, HEAD for latest commit, or divergence for the automatically detected base."
      },
      "includeUncommitted": {
        "type": "boolean",
        "description": "Include staged, unstaged and untracked files in branch mode."
      }
    }
  }
}
