{
  "id": "diff",
  "label": "Diff",
  "description": "Read-only Git changes with unified patches.",
  "configVersion": 1,
  "sdkVersion": 1,
  "entrypoint": "entrypoint.tsx",
  "runtime": null,
  "capabilities": ["process", "storage"],
  "defaults": {
    "folder": null,
    "mode": "branch",
    "baseRef": "HEAD~1",
    "targetRef": "HEAD",
    "compareFrom": "divergence",
    "includeUncommitted": false
  },
  "contextDefaults": {
    "folder": "session.directory"
  },
  "examples": [
    {},
    {
      "mode": "refs",
      "baseRef": "HEAD~1",
      "targetRef": "HEAD"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "folder": {
        "type": ["string", "null"],
        "absolutePath": true,
        "maxBytes": 8192,
        "description": "Repository directory; defaults to session directory."
      },
      "mode": {
        "type": "string",
        "enum": ["branch", "refs", "auto", "workingDirectory", "mergeBase", "sinceCommit"],
        "description": "branch: detected base or selected commit to HEAD, optionally including local changes; refs: two committed snapshots. Other values are accepted for legacy saved tabs."
      },
      "baseRef": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Starting revision for refs mode."
      },
      "targetRef": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Destination revision for refs mode."
      },
      "compareFrom": {
        "type": "string",
        "minLength": 1,
        "maxBytes": 8192,
        "description": "Branch starting commit, HEAD for latest commit, or divergence for the automatically detected base."
      },
      "includeUncommitted": {
        "type": "boolean",
        "description": "Include staged, unstaged and untracked files in branch mode."
      }
    }
  },
  "interactions": {
    "version": 1,
    "state": {
      "description": "Existing comparison and bounded file metadata, without patches or Git refresh.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "comparison": {
                "type": ["object", "null"],
                "properties": {
                  "root": {
                    "type": "string"
                  },
                  "config": {
                    "type": "object"
                  },
                  "base": {
                    "type": "string"
                  },
                  "target": {
                    "type": ["string", "null"]
                  }
                },
                "additionalProperties": false
              },
              "revision": {
                "type": "string"
              },
              "totalFiles": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "oldPath": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "expanded": {
                      "type": "boolean"
                    },
                    "viewed": {
                      "type": "boolean"
                    },
                    "patchAvailable": {
                      "type": "boolean"
                    }
                  },
                  "required": ["path", "oldPath", "status", "expanded", "viewed", "patchAvailable"]
                }
              },
              "nextOffset": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "loading": {
                "type": "boolean"
              },
              "error": {
                "type": ["string", "null"]
              },
              "changeCounts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "comparison",
              "revision",
              "totalFiles",
              "files",
              "nextOffset",
              "loading",
              "error",
              "changeCounts"
            ]
          },
          "observedAt": {
            "type": ["string", "null"]
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": ["summary", "data", "observedAt", "stale"]
      },
      "examples": [
        {
          "args": {}
        }
      ]
    },
    "actions": {
      "set-files-expanded": {
        "description": "Set file expanded state atomically. Viewed requires the revision returned by state and loaded successful patches.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expanded": {
              "type": "boolean"
            }
          },
          "required": ["paths", "expanded"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "updated": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["updated"]
        },
        "examples": [
          {
            "args": {
              "paths": ["package-lock.json"],
              "expanded": false
            },
            "result": {
              "updated": 1
            }
          }
        ],
        "readOnly": false
      },
      "set-files-viewed": {
        "description": "Set file viewed state atomically. Viewed requires the revision returned by state and loaded successful patches.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "viewed": {
              "type": "boolean"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": ["paths", "viewed", "revision"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "updated": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["updated"]
        },
        "examples": [
          {
            "args": {
              "paths": ["package-lock.json"],
              "viewed": false,
              "revision": "opaque-token-from-state"
            },
            "result": {
              "updated": 1
            }
          }
        ],
        "readOnly": false
      }
    }
  }
}
