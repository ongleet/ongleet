{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevCenter",
  "version": "0.1.0",
  "identifier": "io.local.devcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevCenter — preview",
        "decorations": false,
        "transparent": true,
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/128x128.png", "icons/32x32.png", "icons/256x256.png", "icons/512x512.png"]
  }
}
