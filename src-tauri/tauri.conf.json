{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Stack Prototype",
  "version": "0.1.0",
  "identifier": "io.local.terminal-stack-prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Terminal stack prototype — validation pending", "width": 1100, "height": 760, "minWidth": 640, "minHeight": 400 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png"] }
}
