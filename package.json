{
  "name": "devcenter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/check-plugin-boundaries.mjs && tsc --noEmit && vite build",
    "tauri": "tauri",
    "check:host": "bash scripts/check-host.sh",
    "check:wasm": "node scripts/check-wasm.mjs",
    "check:terminal-reuse": "node scripts/check-terminal-reuse.mjs",
    "check:rendering": "node scripts/check-rendering.mjs",
    "check:terminal-input": "node scripts/check-terminal-input.mjs",
    "check:terminal-selection": "node scripts/check-terminal-selection.mjs",
    "check:engine-loader": "node scripts/check-engine-loader.mjs",
    "check:editor-merge": "node scripts/check-editor-merge.mjs",
    "check:pr-status": "node scripts/check-pr-status.mjs",
    "check:plugins": "node scripts/check-plugin-boundaries.mjs",
    "package:deb": "tauri build --bundles deb"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "ghostty-web": "0.4.0",
    "node-diff3": "^3.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
